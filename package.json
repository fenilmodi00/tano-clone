{
  "name": "tano-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Next.js rebuild of the Tano marketing site",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "react",
    "website-clone",
    "reverse-engineering"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run content:check && npm run content:validate && npm run lint && npm run typecheck && npm run test && npm run build && npm run assert:static",
    "verify": "node scripts/verify-all.mjs --widths 1568 --concurrency 3",
    "verify:motion": "node scripts/compare-motion.mjs --scene all --width 1568",
    "verify:visibility": "node scripts/check-visibility.mjs",
    "verify:client-nav": "node scripts/audit-client-nav.mjs --base http://127.0.0.1:3000",
    "verify:nav": "node scripts/check-nav-regressions.mjs",
    "content:manifest": "node scripts/generate-route-manifest.mjs",
    "content:check": "node scripts/generate-route-manifest.mjs --check",
    "content:validate": "tsx scripts/validate-content.ts",
    "verify:smoke": "node scripts/smoke-routes.mjs",
    "verify:links": "node scripts/audit-links.mjs",
    "verify:failsafe": "node scripts/check-failsafe.mjs",
    "verify:remote": "node scripts/check-motion-origin.mjs https://dev.kaplun.tech",
    "assert:static": "node scripts/assert-static-output.mjs",
    "verify:reload": "node scripts/check-reload-scroll.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.5.0",
    "lenis": "^1.3.29",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.6",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "htmltojsx": "^0.3.0",
    "jsdom": "^31.0.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  },
  "type": "module"
}
