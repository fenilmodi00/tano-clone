# Headers for assets served directly by Workers Static Assets. HTML, RSC and
# video stay worker-first; fonts, images (including the immutable captures in
# /sites/tano/extras), brand marks and hashed build output skip the Worker.
# Keep these cache policies in sync with next.config.ts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/sites/tano/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sites/tano/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Captured images (jpg, jpeg, png, webp, avif) skip the Worker; video under
# this path stays worker-first for Range handling.
/sites/tano/extras/*
  Cache-Control: public, max-age=31536000, immutable

/brand-mark/*
  Cache-Control: public, max-age=31536000, immutable
