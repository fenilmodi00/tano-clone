# Canonical origin used for metadata, canonical links, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# This project is a reference clone. Search indexing stays off unless set true.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Comma-separated hostnames allowed to load Next dev resources.
ALLOWED_DEV_ORIGINS=127.0.0.1,localhost
